# Copy to .env (gitignored) and fill in. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neno?sslmode=require
PORT=8080


S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neno-media
S3_ACCESS_KEY=neno
S3_SECRET_KEY=nenodevsecret


# Keycloak realm that issues access tokens (API validates iss + aud=neno-api via JWKS).
KEYCLOAK_ISSUER=https://sso.mala.co.tz/realms/neno
KEYCLOAK_AUDIENCE=neno-api

# Offline packs: cmd/packs writes here; the API serves the files at /packs/{file}.
PACKS_DIR=./tmp/packs
PACKS_BASE_URL=http://localhost:8080
